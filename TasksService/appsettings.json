{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Tasks": "Host=postgres-t;Port=5432;Database=tasksdb;Username=tasks;Password=password"
  },
  "Authentication": {
    "Authority": "http://localhost:8081/realms/tasks-realm",
    "Audience": "tasksservice",
    "RequireHttpsMetadata": false
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "rabbitmq",
    "Password": "rabbitmq",
    "QueueName": "tasks-queue"
  },
  "TaskServiceMocking": {
    "HoldFailureProbability": 0.05,
    "TransferFailureProbability": 0.05,
    "MinDelayMs": 50,
    "MaxDelayMs": 500
  }
}
